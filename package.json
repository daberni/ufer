    "db:verify-backup": "tsx scripts/verify-backup.ts",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "format:styles": "prettier --write \"src/**/*.css\"",
    "check:styles": "stylelint \"src/**/*.css\" && prettier --check \"src/**/*.css\"",
    "user:create": "tsx scripts/manage-users.ts create",
    "user:reset-password": "tsx scripts/manage-users.ts reset-password",
    "screenshots": "tsx scripts/capture-screenshots.ts"
  },
  "engines": {
    "node": "26.x"
  },
  "dependencies": {
