    "re2js": "^2.10.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "temporal-polyfill": "^1.0.8",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^8.1.2",
    "@csstools/postcss-global-data": "^4.0.0",
