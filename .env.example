APP_URL=http://localhost:3000
DATABASE_URL=file:data/budget.db
# Required on Vercel: libsql://... and DATABASE_AUTH_TOKEN. Never use /tmp for persistent data.
DATABASE_AUTH_TOKEN=
# SANDBOX and PRODUCTION data are stored separately in the same schema.
ENABLE_BANKING_ENVIRONMENT=SANDBOX
ENABLE_BANKING_APP_ID=
# Read the downloaded key from outside the project; alternatively set PRIVATE_KEY to a PEM string in your hosting secrets.
ENABLE_BANKING_PRIVATE_KEY_PATH=
ENABLE_BANKING_PRIVATE_KEY=
ENABLE_BANKING_REDIRECT_URL=http://localhost:3000/api/banking/callback
# Generate independent random values with: openssl rand -hex 32
BETTER_AUTH_SECRET=
DATA_ENCRYPTION_KEY=
CRON_SECRET=
# Optional EODHD API token for daily security prices (your own account; personal-use terms). Empty: no price source, holdings show missing prices.
MARKET_DATA_API_KEY=
# Docker Compose only: absolute host path to the PEM file.
ENABLE_BANKING_PRIVATE_KEY_HOST_PATH=
# Operator details for the public /privacy and /terms pages. Name and place of residence (municipality and country) are required; the contact email is optional.
OPERATOR_NAME=
OPERATOR_RESIDENCE=
OPERATOR_EMAIL=
# JSON list of hosting/database providers processing data for this installation; [] when none are used.
DATA_PROCESSORS=
# Header the platform or reverse proxy overwrites with the client address, for per-client authentication rate limits:
# x-forwarded-for on Vercel, e.g. X-Real-IP behind nginx. Leave empty when clients can reach the app directly.
TRUSTED_CLIENT_IP_HEADER=
# Optional NAS binding and daily sync hour (Europe/Vienna).
BIND_ADDRESS=127.0.0.1
PORT=3000
SYNC_HOUR=6
